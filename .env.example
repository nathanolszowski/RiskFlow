# Copier en .env (ignoré par Git) et remplir
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_SSLMODE=
INSEE_API_KEY=
# Stockage des médias en prod (Cloudflare R2 via le protocole S3)
AWS_STORAGE_BUCKET_NAME=
# Endpoint S3 (R2). Laisser vide pour AWS S3
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=auto
# Limites (Mo), optionnelles
MEDIA_MAX_IMAGE_MB=25
MEDIA_MAX_PDF_MB=25
MEDIA_MAX_OFFICE_MB=25
MEDIA_MAX_VIDEO_MB=100
MEDIA_FOLDER_QUOTA_MB=500
# Géoplateforme IGN (géocodage, itinéraires) : services publics sans clé, valeurs par défaut
# GEOPF_GEOCODING_URL=https://data.geopf.fr/geocodage
# GEOPF_ROUTING_URL=https://data.geopf.fr/navigation/itineraire
# GEOCODING_MIN_SCORE=0.5
# GEOCODING_ENABLED=1
